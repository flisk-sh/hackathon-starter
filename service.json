{
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "web",
  "appType": "frontend",
  "command": "npm run scss && node --watch app.js",
  "port": 8080,
  "healthCheckPath": "/",
  "dependsOn": ["mongo"],
  "env": {
    "BASE_URL": "http://localhost:8080",
    "MONGODB_URI": "mongodb://localhost:27017/hackathon-starter"
  }
}
